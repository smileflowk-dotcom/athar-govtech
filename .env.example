# Port local du démonstrateur ATHAR
ATHAR_PORT=3000

# Chemin du stockage persistant dans le conteneur
ATHAR_DATA_DIR=/data

# Assistance Gemini optionnelle — désactivée par défaut.
# Ne pas activer pour des documents sensibles sans cadre institutionnel autorisé.
ATHAR_GEMINI_ENABLED=false
ATHAR_GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=
