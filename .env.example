# Port local du démonstrateur ATHAR
ATHAR_PORT=3000

# Chemin du stockage persistant dans le conteneur
ATHAR_DATA_DIR=/data

# Runtime IA strictement local pour la tranche PoC grille + PV.
# Valeurs acceptées par le code : localhost/127.0.0.1, ollama ou host.docker.internal.
ATHAR_LOCAL_MODEL_URL=http://127.0.0.1:11434

# Modèle quantifié compact prévu pour CPU et VM 8-16 Go sans GPU.
ATHAR_LOCAL_MODEL=qwen2.5:1.5b-instruct-q4_K_M
